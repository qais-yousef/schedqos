{
	"throughput": {
		"debugfs": {
			"features": ["NO_HRTICK"],
			"base_slice_ns": "8000000"
		},
		"cpufreq": {
			"scaling_governor": "schedutil"
		},
		"sysfs": {
			"/sys/devices/system/cpu/intel_pstate/status": "active",
			"/sys/devices/system/cpu/amd_pstate/status": "active"
		},
		"sysctl": {
			"/proc/sys/kernel/sched_autogroup_enabled": "1"
		}
	},
	"interactive": {
		"debugfs": {
			"features": ["HRTICK"],
			"base_slice_ns": "4000000"
		},
		"cpufreq": {
			"scaling_governor": "schedutil"
		},
		"sysfs": {
			"/sys/devices/system/cpu/intel_pstate/status": "active",
			"/sys/devices/system/cpu/amd_pstate/status": "active"
		},
		"sysctl": {
			"/proc/sys/kernel/sched_autogroup_enabled": "1"
		}
	},
	"qos": {
		"debugfs": {
			"features": ["HRTICK", "NO_SIS_UTIL"],
			"base_slice_ns": "16000000"
		},
		"cpufreq": {
			"scaling_governor": "schedutil"
		},
		"sysfs": {
			"/sys/devices/system/cpu/intel_pstate/status": "passive",
			"/sys/devices/system/cpu/amd_pstate/status": "passive"
		},
		"sysctl": {
			"/proc/sys/kernel/sched_autogroup_enabled": "0"
		}
	}
}
